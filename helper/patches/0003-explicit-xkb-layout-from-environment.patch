From 1f1b48ad93de009ea845b595b4051ce3154e34e7 Mon Sep 17 00:00:00 2001
From: Bart Schelstraete <bart@schelstraete.org>
Date: Sat, 22 Aug 2026 05:33:37 +0200
Subject: [PATCH] fix: XKB layout from environment and CapsLock keymap entry
 fix
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Three fixes for headless libei clients:

1. EiKeyState::initDefaultKeymap reads XKB_DEFAULT_* env vars explicitly
   and passes them as xkb_rule_names. Fixes keymap guessing in flatpak
   sandbox with QT_QPA_PLATFORM=offscreen.

2. DeskflowXkbKeyboard reads XKB_DEFAULT_LAYOUT when no X display is
   available, so the correct language is advertised to the server.

3. EiKeyState::getKeyMap CapsLock entry generation: the in-place mutation
   of m_required destroyed the original value, so unshifted letters had
   no entry with m_required=0. findBestKey then picked a CapsLock entry,
   causing keysForModifierState to toggle CapsLock ON before pressing the
   key — producing uppercase output. Save and restore the original
   m_required so the unshifted entry is preserved.
---
 src/lib/deskflow/unix/DeskflowXkbKeyboard.cpp | 13 ++++++++-
 src/lib/platform/EiKeyState.cpp               | 28 +++++++++++++++++--
 2 files changed, 38 insertions(+), 3 deletions(-)

diff --git a/src/lib/deskflow/unix/DeskflowXkbKeyboard.cpp b/src/lib/deskflow/unix/DeskflowXkbKeyboard.cpp
index b04af71..1783447 100644
--- a/src/lib/deskflow/unix/DeskflowXkbKeyboard.cpp
+++ b/src/lib/deskflow/unix/DeskflowXkbKeyboard.cpp
@@ -7,6 +7,8 @@
 
 #if WINAPI_XWINDOWS
 #include "base/Log.h"
+#include <cstdlib>
+#include <cstring>
 #include <memory>
 
 #include "DeskflowXkbKeyboard.h" // Include last due to X11 use
@@ -23,7 +25,16 @@ DeskflowXkbKeyboard::DeskflowXkbKeyboard()
       LOG_WARN("error reading keyboard layouts");
     }
   } else {
-    LOG_WARN("can't open xkb display during reading languages");
+    const char *envLayout  = std::getenv("XKB_DEFAULT_LAYOUT");
+    const char *envVariant = std::getenv("XKB_DEFAULT_VARIANT");
+    if (envLayout && envLayout[0]) {
+      m_data.layout = strdup(envLayout);
+      if (envVariant && envVariant[0])
+        m_data.variant = strdup(envVariant);
+      LOG_INFO("xkb display unavailable; using XKB_DEFAULT_LAYOUT=%s", envLayout);
+    } else {
+      LOG_WARN("can't open xkb display and XKB_DEFAULT_LAYOUT is not set; defaulting to us");
+    }
   }
 }
 
diff --git a/src/lib/platform/EiKeyState.cpp b/src/lib/platform/EiKeyState.cpp
index 473ae66..5b7dacc 100644
--- a/src/lib/platform/EiKeyState.cpp
+++ b/src/lib/platform/EiKeyState.cpp
@@ -14,6 +14,7 @@
 #include "platform/XDGKeyUtil.h"
 
 #include <cstddef>
+#include <cstdlib>
 #include <memory>
 #include <unistd.h>
 
@@ -39,7 +40,27 @@ void EiKeyState::initDefaultKeymap()
   if (m_xkbKeymap) {
     xkb_keymap_unref(m_xkbKeymap);
   }
-  m_xkbKeymap = xkb_keymap_new_from_names(m_xkb, nullptr, XKB_KEYMAP_COMPILE_NO_FLAGS);
+  const char *rules   = std::getenv("XKB_DEFAULT_RULES");
+  const char *model   = std::getenv("XKB_DEFAULT_MODEL");
+  const char *layout  = std::getenv("XKB_DEFAULT_LAYOUT");
+  const char *variant = std::getenv("XKB_DEFAULT_VARIANT");
+  const char *options = std::getenv("XKB_DEFAULT_OPTIONS");
+
+  const bool hasOverride = rules || model || layout || variant || options;
+
+  struct xkb_rule_names names = {
+    .rules   = rules,
+    .model   = model,
+    .layout  = layout,
+    .variant = variant,
+    .options = options,
+  };
+
+  LOG_INFO("xkb default keymap: layout=%s variant=%s model=%s%s",
+           layout ? layout : "(default)", variant ? variant : "(none)",
+           model ? model : "(default)", hasOverride ? "" : " (no overrides)");
+
+  m_xkbKeymap = xkb_keymap_new_from_names(m_xkb, hasOverride ? &names : nullptr, XKB_KEYMAP_COMPILE_NO_FLAGS);
 
   if (m_xkbState) {
     xkb_state_unref(m_xkbState);
@@ -282,13 +303,16 @@ void EiKeyState::getKeyMap(deskflow::KeyMap &keyMap)
 
         assignGeneratedModifiers(keycode, item);
 
-        // add capslock version of key is sensitive to capslock
+        // add capslock version of key if sensitive to capslock
         if (item.m_sensitive & KeyModifierShift && item.m_sensitive & KeyModifierCapsLock) {
+          auto origRequired = item.m_required;
           item.m_required &= ~KeyModifierShift;
           item.m_required |= KeyModifierCapsLock;
           keyMap.addKeyEntry(item);
           item.m_required |= KeyModifierShift;
           item.m_required &= ~KeyModifierCapsLock;
+          keyMap.addKeyEntry(item);
+          item.m_required = origRequired;
         }
 
         keyMap.addKeyEntry(item);
-- 
